// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum CategoryType {
  WORK
  SOURCE
  TEMPLATE
  BROCHURE
  ADMIN
  ETC
  INSIGHTS // 사이드바 INSIGHTS 섹션. enum 끝에 추가 → 마이그레이션은 순수 ADD VALUE(데이터 보존). 사이드바 순서는 Sidebar.tsx categoryOrder가 제어하므로 선언 위치와 무관.
}

enum PostStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum DesignRequestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
}

// ICON+ 기능: SVG 리소스를 사내망 DB에 텍스트로 저장(오브젝트 스토리지 미사용).
// 기존 ICON(Post + MinIO)과 완전 분리. 계획: docs/ICON_PLUS_개발계획.md
enum IconPlusType {
  MAIN
  MERGE_ICON
  MERGE_TEXT
}

// MAIN 아이콘 마스킹 프리셋의 위치. 위치를 늘리려면 값만 추가하면 된다(테이블 구조 변경 없음).
// 계획: docs/ICON_PLUS_절단마스킹_구현계획.md
enum IconPlusCutPosition {
  TOP_RIGHT
  BOTTOM_RIGHT
}

model IconPlusResource {
  id         String       @id @default(cuid())
  type       IconPlusType
  name       String
  svgContent String       @db.Text // 정규화·sanitize된 SVG 원본
  viewBox    String
  width      Float
  height     Float
  baseWidth  Float? // MAIN 전용
  baseHeight Float? // MAIN 전용
  // legacy — 프리셋 없는 pre-cut MAIN 아이콘 전용 병합 기준점.
  // 프리셋(IconPlusMainPreset)이 있으면 사용하지 않는다(두 방식 공존).
  anchorX    Float?
  anchorY    Float?
  authorId   String? // 업로드한 관리자 추적(감사용)
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  presets IconPlusMainPreset[]

  @@index([type, createdAt])
  @@map("icon_plus_resources")
}

/// MAIN 아이콘의 마스킹 프리셋. 위치별로 (절단 원 + 병합 앵커) 한 세트를 보관한다.
model IconPlusMainPreset {
  id         String              @id @default(cuid())
  resourceId String
  position   IconPlusCutPosition
  cutX       Float // 절단 원 중심 X (viewBox 좌표계)
  cutY       Float // 절단 원 중심 Y
  cutRadius  Float // 절단 원 반경 (> 0)
  anchorX    Float // 병합 리소스 좌상단 X (음수 허용 — 아이콘 밖 오버플로)
  anchorY    Float // 병합 리소스 좌상단 Y (음수 허용)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Cascade 필수: DELETE /api/icon-plus는 deleteMany로 리소스를 일괄 삭제한다.
  resource IconPlusResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, position])
  @@map("icon_plus_main_presets")
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  name                     String?
  password                 String? // hashed (Google OAuth 사용자는 null 가능)
  avatar                   String? // Backblaze B2 URL
  role                     UserRole @default(MEMBER)
  // 디자인 의뢰 등록 알림 메일 수신 여부(관리자 대상). false면 해당 관리자 제외. 기본 수신.
  receiveDesignRequestMail Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  posts                 Post[]                 @relation("PostAuthor")
  updatedPosts          Post[]                 @relation("PostUpdater")
  notices               Notice[]
  welcomeBoardTemplates WelcomeBoardTemplate[]
  diagrams              Diagram[]              @relation("DiagramAuthor")
  edms                  Edm[]                  @relation("EdmAuthor")
  desktopWallpapers     DesktopWallpaper[]
  hardwareProducts      HardwareProduct[]
  cardTemplates         CardTemplate[]
  designRequests        DesignRequest[]
  menuSubscriptions     MenuSubscription[]
  iconPlusResources     IconPlusResource[]
  insightPosts          InsightPost[]          @relation("InsightPostAuthor")
  updatedInsightPosts   InsightPost[]          @relation("InsightPostUpdater")

  @@map("users")
}

model Category {
  id          String       @id @default(cuid())
  name        String // "Penta Design", "CI/BI", "PPT" 등
  slug        String       @unique // URL-friendly identifier
  type        CategoryType
  pageType    String? // "gallery" | "editor" | "list" | "custom" - 페이지 타입
  config      Json? // 카테고리별 설정 (UI 옵션, 기능 플래그 등)
  parentId    String? // 상위 카테고리 (null이면 최상위)
  order       Int          @default(0) // 정렬 순서
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent        Category?          @relation("CategoryParent", fields: [parentId], references: [id])
  children      Category[]         @relation("CategoryParent")
  posts         Post[]
  subscriptions MenuSubscription[]
  insightPosts  InsightPost[]

  @@map("categories")
}

// 메뉴(카테고리)별 사용자 구독 — 게시물 추가/수정 시 이메일 알림 대상
model MenuSubscription {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@map("menu_subscriptions")
}

model Post {
  id            String     @id @default(cuid())
  title         String
  subtitle      String? // 부제목
  description   String?
  thumbnailUrl  String? // 썸네일 이미지 URL (Backblaze B2)
  fileUrl       String // 원본 파일 URL (Backblaze B2) - 하위 호환성 유지
  images        Json? // 여러 이미지 배열 [{url: string, name: string, order: number}]
  fileSize      Int // 파일 크기 (bytes)
  fileType      String // "image/png", "application/zip" 등
  mimeType      String? // MIME 타입
  categoryId    String
  status        PostStatus @default(PUBLISHED)
  isEditable    Boolean    @default(false) // SVG 편집 가능 여부
  viewCount     Int        @default(0)
  downloadCount Int        @default(0)
  concept       String? // CONCEPT 정보
  tool          String? // TOOL 정보
  producedAt    DateTime? // 제작일

  authorId    String
  author      User    @relation("PostAuthor", fields: [authorId], references: [id])
  updatedById String?
  updatedBy   User?   @relation("PostUpdater", fields: [updatedById], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  tags PostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("posts")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String // Markdown 지원
  isImportant Boolean  @default(false)
  viewCount   Int      @default(0)
  attachments Json? // 첨부파일 배열 [{url: string, name: string}]
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notices")
}

// 웰컴보드 템플릿 모델
model WelcomeBoardTemplate {
  id            String  @id @default(cuid())
  name          String
  description   String?
  thumbnailUrl  String? // B2 썸네일 이미지 경로
  backgroundUrl String // B2 배경 이미지 경로
  width         Int     @default(1920)
  height        Int     @default(1080)
  config        Json // 텍스트/로고 요소 설정 JSON
  status        String  @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("welcomeboard_templates")
}

// 다이어그램 모델
model Diagram {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String? // B2 썸네일 이미지 경로
  canvasData   Json // Konva 캔버스 상태 (도형, 텍스트 등)
  width        Int     @default(1920)
  height       Int     @default(1080)

  authorId String
  author   User   @relation("DiagramAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagrams")
}

// eDM 모델
model Edm {
  id           String  @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String? // Supabase Storage 썸네일 이미지 URL
  imageWidth   Int // 원본 이미지 너비
  imageHeight  Int // 원본 이미지 높이
  gridConfig   Json // { rows: number[], cols: number[], mergedCells: MergedCell[] }
  cellLinks    Json // { "row-col": "https://..." }
  cellImages   Json // { "row-col": "Supabase Storage URL" } - 저장 시 업로드된 셀 이미지
  htmlCode     String? // 생성된 HTML
  alignment    String  @default("left") // left | center | right

  authorId String
  author   User   @relation("EdmAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("edms")
}

// 바탕화면 모델
model DesktopWallpaper {
  id                   String  @id @default(cuid())
  title                String
  description          String?
  thumbnailUrl         String? // B2 - 윈도우용 배경에서 자동 생성
  backgroundUrlWindows String? // B2 - 16:9, 2560x1440
  backgroundUrlMac     String? // B2 - 16:10, 2560x1600
  widthWindows         Int     @default(2560)
  heightWindows        Int     @default(1440)
  widthMac             Int     @default(2560)
  heightMac            Int     @default(1600)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("desktop_wallpapers")
}

// 하드웨어 제품 갤러리 모델 (단일 이미지, 뷰어+다운로드 전용)
model HardwareProduct {
  id           String  @id @default(cuid())
  title        String
  description  String?
  type         String? // 제품 타입 (WAPPLES, D.AMO, iSIGN) — 필터용
  imageUrl     String // 원본 제품 이미지 (S3/MinIO posts 버킷)
  thumbnailUrl String? // 카드용 썸네일 (원본에서 자동 생성)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hardware_products")
}

// 감사/연말 카드 템플릿 모델
model CardTemplate {
  id               String  @id @default(cuid())
  name             String
  description      String?
  thumbnailUrl     String? // B2 썸네일 이미지 경로
  backgroundImages Json // [{ url, width, height, label? }] 동일 디자인 여러 크기/비율
  width            Int     @default(1080) // 기본 캔버스
  height           Int     @default(1920)
  config           Json // 텍스트/로고 요소 설정 (제목, 부제목, 인사말, 발신자, 로고영역)
  status           String  @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("card_templates")
}

// 다이어그램 ZIP 파일 설정 (관리자 업로드, 사용자 다운로드) - 단일 행
model DiagramZipConfig {
  id          String   @id @default(cuid())
  key         String   @unique @default("default")
  zipFileUrl  String?
  zipFileName String?
  zipFileSize Int?
  updatedAt   DateTime @updatedAt

  @@map("diagram_zip_config")
}

model DesignRequest {
  id             String              @id @default(cuid())
  title          String
  content        String
  departmentTeam String
  dueDate        DateTime            @db.Date
  status         DesignRequestStatus @default(REQUESTED)
  authorId       String
  author         User                @relation(fields: [authorId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  attachments DesignRequestAttachment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([status])
  @@map("design_requests")
}

// 디자인 의뢰 첨부파일 (1:N). posts 버킷 design-requests/ prefix에 저장, DB에는 메타데이터+URL.
// 의뢰당 최대 5개·파일당 25MB·확장자 화이트리스트는 lib/design-request-attachments.ts 에서 관리.
model DesignRequestAttachment {
  id        String        @id @default(cuid())
  requestId String
  request   DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String // 원본 파일명(표시·다운로드명)
  fileUrl   String // posts 버킷 객체 URL/키
  fileSize  Int // bytes
  mimeType  String
  createdAt DateTime      @default(now())

  @@index([requestId])
  @@map("design_request_attachments")
}

// INSIGHTS: 「AI 사용가이드」(카드 갤러리)·「최신 동향」(게시판) 공용 모델.
// 자기완결형 HTML 문서는 S3(posts 버킷 insights/ prefix)에 text/html로 저장하고, DB에는 메타데이터+URL만 보관.
// 페이지 구분은 categoryId(pageType: insights-guide | insights-trend). 태그 미사용. 계획: docs/INSIGHTS_구현계획.md
model InsightPost {
  id           String  @id @default(cuid())
  categoryId   String // insights-guide / insights-trend 구분 (구독·라우팅·목록·검색)
  title        String
  description  String? // AI 사용가이드 카드의 간단한 설명 (최신 동향은 미사용)
  htmlUrl      String // S3 posts 버킷의 text/html 객체 URL
  htmlFileName String // 원본 파일명
  htmlFileSize Int // bytes
  thumbnailUrl String? // 카드용 썸네일 (선택; 없으면 플레이스홀더)
  cardColor    String? // AI 사용가이드 카드 그라데이션 우하단 색(HEX). 없으면 기본 중립색. (최신 동향 미사용)
  viewCount    Int     @default(0)

  authorId    String
  author      User    @relation("InsightPostAuthor", fields: [authorId], references: [id])
  updatedById String?
  updatedBy   User?   @relation("InsightPostUpdater", fields: [updatedById], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, createdAt])
  @@map("insight_posts")
}

// 전역 앱 설정 (단일 행)
model AppSettings {
  id                      String   @id @default("default")
  showCredentialsLogin    Boolean  @default(true)
  menuSubscriptionEnabled Boolean  @default(true) // 메뉴 구독 알림 기능 전역 on/off
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}
