# Nginx — 앞단(HTTP) → Next(컨테이너 app:3000) 및 MinIO(컨테이너 minio:9000)
# 도커 컨테이너 내부의 Nginx는 80번 포트로 들어오는 요청을 받아 내부망으로 분기합니다.

server {
    listen 80;
    server_name design5.pentasecurity.com;
    client_max_body_size 500m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # 1. 일반 웹 요청 -> Next.js 앱 컨테이너(app:3000)로 전달
    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 2. [핵심 수정] 이미지/파일 요청 -> MinIO 컨테이너(minio:9000)로 전달
    # 브라우저가 /posts/... 로 이미지를 달라고 하면, Nginx가 내부망의 minio 컨테이너에서 꺼내옵니다.
    location /posts/ {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
